<?xml version="1.0"?>
<sprites>
	<sprite string_id="zap:stingby" name="Stingby">
	</sprite>
	
	<sprite string_id="zap:timeclock" name="Time Clock">
		<value nybble="10-12" title="Time Amount"/>
	</sprite>
	
	<sprite string_id="zap:angrygrrrol" name="Angry Grrrol">
		<value nybble="5" title="Maximum Speed"/>
		<value nybble="6" title="Acceleration"/>
		<checkbox nybble="7" title="Break Blocks (Sides)" comment="Destroys blocks on collision from the side."/>
		<checkbox nybble="8" title="Break Blocks (Down)" comment="Destroys blocks below."/>
	</sprite>
	
	<sprite string_id="zap:flybones" name="Fly Bones">
	    
	</sprite>

	<sprite string_id="zap:biddybud" name="Biddybud">
		<list nybble="5" title="Color">
            <entry value="0">Red</entry>
            <entry value="1">Yellow</entry>
            <entry value="2">Green</entry>
            <entry value="3">Blue</entry>
            <entry value="4">Pink</entry>
        </list>
		<list nybble="20" title="Movement Type">
			<entry value="0">None</entry>
			<entry value="1">Sway Or Spin (68, 69, 116, 118)</entry>
			<entry value="2">Bolt (238)</entry>
			<entry value="3">Path (100)</entry>
			<entry value="4">Two-Way (70)</entry>
			<entry value="6">BoltMushroom (241)</entry>
			<entry value="7">No-bolt Mushroom (242)</entry>
			<entry value="8">Shifting Platform (132)</entry>
			<entry value="9">Spinning (214, 484)</entry>
			<entry value="10">Rolling Hill (265)</entry>
			<entry value="11">Moving Mushroom Lift (210)</entry>
		</list>
        <value nybble="21-22" title="Movement ID"/>
	</sprite>

	<sprite string_id="zap:note" name="Music Note" notes="A note for the clef challenge.">
        <value nybble="1-2" title="Manager ID"/>
        <list nybble="3" title="Note Sound">
            <entry value="0">First C</entry>
            <entry value="1">D</entry>
            <entry value="2">E</entry>
            <entry value="3">F</entry>
            <entry value="4">G</entry>
            <entry value="5">A</entry>
            <entry value="6">B</entry>
            <entry value="7">Second C</entry>
        </list>
        <list nybble="20" title="Movement Type">
			<entry value="0">None</entry>
			<entry value="1">Sway Or Spin (68, 69, 116, 118)</entry>
			<entry value="2">Bolt (238)</entry>
			<entry value="3">Path (100)</entry>
			<entry value="4">Two-Way (70)</entry>
			<entry value="6">BoltMushroom (241)</entry>
			<entry value="7">No-bolt Mushroom (242)</entry>
			<entry value="8">Shifting Platform (132)</entry>
			<entry value="9">Spinning (214, 484)</entry>
			<entry value="10">Rolling Hill (265)</entry>
			<entry value="11">Moving Mushroom Lift (210)</entry>
		</list>
        <value nybble="21-22" title="Movement ID"/>
    </sprite>

	<sprite string_id="zap:clef" name="Clef" notes="A clef that spawns multiple music notes when collected. Collect them all within the time limit for an item!">
        <value nybble="1-2" title="Manager ID"/>
        <value nybble="3-4" title="Target Note Count" comment="The required number of notes with a matching ID to activate an event."/>
        <list nybble="5" title="Powerup" comment="The powerup reward once all notes are collected.">
            <entry value="0">Mushroom</entry>
            <entry value="1">Fire Flower</entry>
            <entry value="2">Ice Flower</entry>
            <entry value="3">Mini Mushroom</entry>
            <entry value="4">Propeller Mushroom</entry>
            <entry value="5">Penguin</entry>
            <entry value="6">Acorn</entry>
            <entry value="7">1-up Mushroom</entry>
            <entry value="8">3-up Moon</entry>
            <entry value="9">1st star coin</entry>
            <entry value="10">2nd star coin</entry>
            <entry value="11">3rd star coin</entry>
        </list>
        <value nybble="6-7" title="Time Limit" comment="In seconds."/>
        <list nybble="20" title="Movement Type">
			<entry value="0">None</entry>
			<entry value="1">Sway Or Spin (68, 69, 116, 118)</entry>
			<entry value="2">Bolt (238)</entry>
			<entry value="3">Path (100)</entry>
			<entry value="4">Two-Way (70)</entry>
			<entry value="6">BoltMushroom (241)</entry>
			<entry value="7">No-bolt Mushroom (242)</entry>
			<entry value="8">Shifting Platform (132)</entry>
			<entry value="9">Spinning (214, 484)</entry>
			<entry value="10">Rolling Hill (265)</entry>
			<entry value="11">Moving Mushroom Lift (210)</entry>
		</list>
        <value nybble="21-22" title="Movement ID"/>
    </sprite>

	<sprite string_id="zap:jumboray" name="Jumbo Ray">
		<value nybble="5-6" title="Altitude" comment="In tiles."/>
		<list nybble="7" title="Horizontal Direction">
			<entry value="0">Right</entry>
			<entry value="1">Left</entry>
		</list>
		<list nybble="8" title="Vertical Direction">
			<entry value="0">Up</entry>
			<entry value="1">Down</entry>
		</list>
		<value nybble="9-10" title="Arc Duration" comment="In seconds from the start point to when it reaches the same Y altitude at the end. Essentially changes the width of the arc."/>
	</sprite>
	
	<sprite string_id="zap:jumborayspawner" name="Jumbo Ray Spawner">
		<value nybble="5-6" title="Altitude" comment="In tiles."/>
		<list nybble="7" title="Horizontal Direction">
			<entry value="0">Right</entry>
			<entry value="1">Left</entry>
		</list>
		<list nybble="8" title="Vertical Direction">
			<entry value="0">Up</entry>
			<entry value="1">Down</entry>
		</list>
		<value nybble="9-10" title="Arc Duration" comment="In seconds from the start point to when it reaches the same Y altitude at the end. Essentially changes the width of the arc."/>
		
		<value nybble="1-2" title="Interval" comment="How many seconds between each spawn."/>
		<value nybble="3" title="Limit" comment="If set, will stop spawning after this many."/>
		<value nybble="21-22" title="Triggering Event ID" comment="If set, will only spawn when this event is active."/>
	</sprite>
</sprites>
