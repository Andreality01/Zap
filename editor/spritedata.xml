	<sprite string_id="zap:string_bank" name="String Bank" notes="Stores an arbitrary 16-character string to be used by other sprites.">
		<strybble nybble="1-24" title="String" category="behavior"/>
		<layer title="Chain Type" category="behavior" type="list">
			<entry value="0">Standalone/First in chain</entry>
			<entry value="1">Second in chain</entry>
			<entry value="2">Third (last) in chain</entry>
		</layer>
		<initialstate title="ID" type="value" category="behavior" id_type="string_bank"/>
	</sprite>
