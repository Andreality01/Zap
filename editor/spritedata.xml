<?xml version="1.0"?>
<sprites>
	<sprite string_id="zap:stingby" name="Stingby">
	</sprite>
	
	<sprite string_id="zap:timeclock" name="Time Clock">
		<value nybble="10-12" title="Time Amount"/>
	</sprite>
	
	<sprite string_id="zap:angrygrrrol" name="Angry Grrrol">
		<value nybble="5" title="Maximum Speed"/>
		<value nybble="6" title="Acceleration"/>
		<checkbox nybble="7" title="Break Blocks (Sides)" comment="Destroys blocks on collision from the side."/>
		<checkbox nybble="8" title="Break Blocks (Down)" comment="Destroys blocks below."/>
	</sprite>
	
	<sprite string_id="zap:flybones" name="Fly Bones">
	    
	</sprite>

	<sprite string_id="zap:biddybud" name="Biddybud">
		<list nybble="5" title="Color">
            <entry value="0">Red</entry>
            <entry value="1">Yellow</entry>
            <entry value="2">Green</entry>
            <entry value="3">Blue</entry>
            <entry value="4">Pink</entry>
        </list>
		<list nybble="20" title="Movement Type">
			<entry value="0">None</entry>
			<entry value="1">Sway Or Spin (68, 69, 116, 118)</entry>
			<entry value="2">Bolt (238)</entry>
			<entry value="3">Path (100)</entry>
			<entry value="4">Two-Way (70)</entry>
			<entry value="6">BoltMushroom (241)</entry>
			<entry value="7">No-bolt Mushroom (242)</entry>
			<entry value="8">Shifting Platform (132)</entry>
			<entry value="9">Spinning (214, 484)</entry>
			<entry value="10">Rolling Hill (265)</entry>
			<entry value="11">Moving Mushroom Lift (210)</entry>
		</list>
        <value nybble="21-22" title="Movement ID"/>
	</sprite>
</sprites>
